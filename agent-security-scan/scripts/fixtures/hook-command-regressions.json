  "rationales": {
    "shell-21": "GNU Bash rejects --rcfile=VALUE; --rcfile consumes a separate operand.",
    "interp-2": "Python startup cluster -Ic selects inline -c code after isolated mode.",
    "interp-5": "Node -p evaluates code and prints its result.",
    "interp-6": "Perl -E selects inline code with optional features enabled.",
    "interp-7": "Perl -le combines line-ending handling with inline -e code.",
    "interp-8": "PHP -r selects inline code; -c instead selects the php.ini path.",
    "cmd-4": "Attached cmd command operands are not modeled.",
    "cmd-5": "The undocumented cmd /r alias is not modeled.",
    "subst-10": "Locale-translated executable text depends on the active message catalogue."
  }
