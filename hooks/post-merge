#!/usr/bin/env bash
# post-merge: after a successful merge or pull, run the merged checkout's installer step `--post-merge`.
#
# The installer decides with the judgment of its install source check: in the checkout the install
# record (~/.ghost-alice/installed-payload.json) names as the install source it goes on with the install
# for every detected host, under the install lock; in any other checkout, such as a worktree that
# inherits core.hooksPath, it prints one line and installs nothing. While another install holds the
# lock, the install refuses and this hook reports the exit code in one line.
#
# A merge never fails because of this hook: no `set -e`, and it always exits 0.

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -f "$REPO_ROOT/install.sh" ] || exit 0

bash "$REPO_ROOT/install.sh" --post-merge
status=$?
if [ "$status" -ne 0 ]; then
    echo "[ghost-alice post-merge] The installer exited $status; the merge itself succeeded."
fi
exit 0
