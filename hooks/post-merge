#!/usr/bin/env bash
MERGED_CHECKOUT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
ROOT="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd -P)" || exit 0
COMMAND="$ROOT/bin/ghost-alice"
[ -f "$COMMAND" ] || exit 0
# git exports GIT_* to hooks; the installer must resolve its own repository.
# shellcheck disable=SC2046  # the variable names must be split
unset $(git rev-parse --local-env-vars 2>/dev/null)
bash "$COMMAND" --post-merge --merged-checkout "$MERGED_CHECKOUT" </dev/null
status=$?
if [ "$status" -ne 0 ]; then
  printf '%s\n' "[ghost-alice post-merge] The installer exited $status; the merge itself succeeded." >&2
fi
exit 0
